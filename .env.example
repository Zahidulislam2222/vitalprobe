# VitalProbe configuration — copy to .env and fill in. NEVER commit .env.
# Full variable list grows per milestone (see BUILD-PLAN §2.5).

# --- target ---
VITALPROBE_TARGET_URL=            # chatbot endpoint under test
VITALPROBE_TARGET_TOKEN=          # optional bearer token (staging only, revocable)

# --- experience store ---
VITALPROBE_DB_PATH=artifacts/vitalprobe.db  # local SQLite run history (gitignored)

# --- entitlements ---
VITALPROBE_LICENSE_FILE=          # optional path to an offline signed license

# --- semantic judges (live calls require --yes-spend) ---
VITALPROBE_JUDGE=none             # none | openai | anthropic | ollama
VITALPROBE_JUDGE_MODEL=           # provider model ID; never hardcoded
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VITALPROBE_OPENAI_BASE_URL=https://api.openai.com/v1
VITALPROBE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OLLAMA_HOST=http://localhost:11434
VITALPROBE_OPENAI_RESPONSES_PATH=/responses
VITALPROBE_ANTHROPIC_MESSAGES_PATH=/messages
VITALPROBE_ANTHROPIC_API_VERSION=2023-06-01
VITALPROBE_OLLAMA_CHAT_PATH=/api/chat
VITALPROBE_JUDGE_TIMEOUT_S=60
VITALPROBE_JUDGE_ESTIMATED_TOKENS_PER_CASE=1500
VITALPROBE_ANTHROPIC_MAX_TOKENS=500
VITALPROBE_LOCAL_MODEL=
VITALPROBE_LOCAL_JUDGE_MAX_ATTEMPTS=3  # initial attempt + two invalid-JSON reprompts
VITALPROBE_JUDGE_OLLAMA_THINK=false    # keep reasoning off so local judges return pure JSON
VITALPROBE_GENERATOR_TEMPERATURE=1.0   # draft-variant generator creativity (learning loop)
VITALPROBE_GENERATOR_MAX_TOKENS=400    # output cap per draft-variant generation call
VITALPROBE_SIMULATOR_TEMPERATURE=0.8   # synthetic-patient next-turn creativity (M8 simulator)
VITALPROBE_SIMULATOR_MAX_TOKENS=200    # output cap per synthetic-patient turn
VITALPROBE_JUDGE_INPUT_PRICE_PER_MILLION=0
VITALPROBE_JUDGE_OUTPUT_PRICE_PER_MILLION=0
VITALPROBE_DEMO_RESPONSES_FILE=  # optional YAML override for scripted demo responses

# --- demo health bot ---
DEMOBOT_PROVIDER=scripted          # scripted | ollama
DEMOBOT_MODEL=                     # required for ollama; use a locally installed model tag
VITALPROBE_DEMO_SYSTEM_PROMPT_FILE= # optional text-file override
VITALPROBE_DEMO_TEMPERATURE=0.2
VITALPROBE_DEMO_MAX_TOKENS=180
VITALPROBE_DEMO_TIMEOUT_S=120
VITALPROBE_DEMO_OLLAMA_THINK=false

# --- runner ---
VITALPROBE_RUNNER_CONCURRENCY=4

# Local dashboard (localhost only by design; no accounts)
VITALPROBE_DASHBOARD_HOST=127.0.0.1
VITALPROBE_DASHBOARD_PORT=8800
